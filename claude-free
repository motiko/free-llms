#!/bin/sh
# Run Claude Code against the LiteLLM proxy (free-tier models via role aliases).
# Usage: claude-free [claude args...]
#   LITELLM_HOST  host running the proxy (default: localhost); also read from .env next to this script
#   LITELLM_PORT  proxy port (default: 4000)
#   CLAUDE_FREE_MODEL  main model (default: smart); any model name the proxy lists, e.g. code
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [ -f "$here/.env" ]; then
  # Read connection settings without exporting provider credentials to Claude.
  LITELLM_HOST="${LITELLM_HOST:-$(. "$here/.env"; printf '%s' "${LITELLM_HOST:-localhost}")}"
  LITELLM_PORT="${LITELLM_PORT:-$(. "$here/.env"; printf '%s' "${LITELLM_PORT:-4000}")}"
fi
export ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-http://${LITELLM_HOST:-localhost}:${LITELLM_PORT:-4000}}"
export ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-sk-local-anything}"
export ANTHROPIC_MODEL="${CLAUDE_FREE_MODEL:-smart}"
export ANTHROPIC_SMALL_FAST_MODEL=fast
export ANTHROPIC_DEFAULT_HAIKU_MODEL=fast
export ANTHROPIC_DEFAULT_SONNET_MODEL="$ANTHROPIC_MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$ANTHROPIC_MODEL"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_PROMPT_CACHING=1
exec claude "$@"
