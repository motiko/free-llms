# Copy to .env and fill in. run.sh sources this file before starting the proxy. Never commit .env.
# Every provider is optional: delete the model_list entries in config.yaml for any key you leave empty.

# Google AI Studio  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq  https://console.groq.com/keys
GROQ_API_KEY=

# Ollama Cloud  https://ollama.com/settings/keys
OLLAMA_API_KEY=

# OpenRouter  https://openrouter.ai/settings/keys   (free tier: ~50 req/day, 1000/day after buying $10 credit)
OPENROUTER_API_KEY=

# Z.ai  https://z.ai/manage-apikey/apikeys   (GLM *-Flash models are free)
ZAI_API_KEY=

# Mistral  https://console.mistral.ai/api-keys   (free Experiment tier: Codestral + Ministral; needs data-training opt-in)
MISTRAL_API_KEY=

# NVIDIA NIM  https://build.nvidia.com/settings/api-keys   (~40 req/min, no card)
NVIDIA_API_KEY=

# Host running the proxy, used by claude-free on client machines (default: localhost)
LITELLM_HOST=localhost

# Proxy listener (loopback by default; use 0.0.0.0 for access from other machines)
LITELLM_BIND_HOST=127.0.0.1
LITELLM_PORT=4000
